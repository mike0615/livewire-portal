# Keepalived for HAProxy VIP (unicast for cross-subnet)
# SECURITY: rotate auth_pass before production. Do NOT commit real secrets.
# Generate with: openssl rand -base64 16
global_defs {
    router_id haproxy1
}

vrrp_script chk_haproxy {
    script "/usr/bin/killall -0 haproxy"
    interval 2
    weight -15
    fall 3
    rise 2
}

vrrp_instance VI_1 {
    state MASTER
    interface ens192
    virtual_router_id 51
    priority 110
    advert_int 1
    unicast_src_ip 10.1.1.10
    unicast_peer {
        10.2.1.10
        10.3.1.10
    }
    authentication {
        auth_type PASS
        # REPLACE with a strong random value (see note above). Never leave the example in prod.
        auth_pass CHANGE_ME_ROTATE_BEFORE_DEPLOY
    }
    virtual_ipaddress {
        10.1.1.100/24
    }
    track_script {
        chk_haproxy
    }
}
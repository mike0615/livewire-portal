-- Prosody config for LiveWire Portal
-- Enable Cyrus SASL for Kerberos or LDAP

VirtualHost "xmpp.example.com"
    enabled = true
    authentication = "cyrus"   -- or "ldap"
    cyrus_service_name = "xmpp"
    modules_enabled = {
        "bosh";
        "websocket";
        "muc";
        "http_file_share";
        "roster";
        "presence";
        "message";
    }
    c2s_require_encryption = true
    s2s_require_encryption = true

-- BOSH / WebSocket for Converse.js
http_ports = { 5280 }
https_ports = { 5281 }

-- MUC rooms
Component "muc.xmpp.example.com" "muc"
    modules_enabled = { "muc_mam" }